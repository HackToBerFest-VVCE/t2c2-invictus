{
  "$schema": "./.vscode/mcp-schema.json",
  "mcpServers": {
    "invariant": {
      "command": "python",
      "args": [
        "-m",
        "packages.mcp_server.server"
      ],
      "env": {
        "GEMINI_API_KEY": "${env:GEMINI_API_KEY}",
        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
        "CLAUDE_API_KEY": "${env:CLAUDE_API_KEY}",
        "COPILOT_API_KEY": "${env:COPILOT_API_KEY}"
      }
    }
  }
}
