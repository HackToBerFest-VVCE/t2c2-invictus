# ==============================================================================
# Invariant Configuration Template
# Copy this file to .env and customize values for local development.
# ==============================================================================

# Application Environment (development, test, production)
INVARIANT_ENV=development
INVARIANT_PORT=8000
INVARIANT_HOST=0.0.0.0
DEBUG=true

# Database Connection (SQLite for local MVP development, PostgreSQL for production)
DATABASE_URL=sqlite:///./invariant.db
# DATABASE_URL=postgresql://invariant_user:invariant_pass@localhost:5432/invariant_db

# GitHub App & Webhook Configuration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Isolated Test Runner Settings
RUNNER_TIMEOUT_SECONDS=300
RUNNER_MAX_MEMORY_MB=2048
RUNNER_MAX_CPUS=2

# Provider-Independent AI Interface (Optional for MVP edge-case suggestions)
# Supported Providers: mock, openai, anthropic, ollama
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini

# Web Application Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000
